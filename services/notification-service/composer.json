{
    "name": "printzone/notification-service",
    "description": "PrintZone Notification Service — stateless consumer of integration events, sends email/SMS/push (Phase 7 extraction)",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/amazon-mailer": "7.4.*",
        "symfony/amqp-messenger": "^7.4",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "^7.4",
        "symfony/property-access": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/serializer": "^7.4",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/twig": "^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
