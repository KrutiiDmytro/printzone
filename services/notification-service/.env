# Notification Service — default (dev) environment. Override secrets in .env.local.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_notification_service_secret

# Email transport. dev → shared Mailpit (monolith compose service `mailer`);
# prod → SES via .env.local.
MAILER_DSN=smtp://mailer:1025

# Sender / reply-to for all outgoing notifications.
ADMIN_EMAIL=admin@example.com

# Inbound integration events (order.*, payment.*, delivery.*, user.*) from the
# monolith's RabbitMQ topic exchange. Only the notification-worker dials the
# broker; it joins the monolith network and reaches it as `rabbitmq`.
# (Transport is wired in Step 2.)
MESSENGER_EVENTS_DSN=amqp://guest:guest@rabbitmq:5672/%2f/events
