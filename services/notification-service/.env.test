# Test environment. Self-contained: no broker, no real SMTP.
APP_ENV=test
APP_DEBUG=0
APP_SECRET=test_secret

# null transport → the SMTP health check treats it as "nothing to dial → ok".
MAILER_DSN=null://null
ADMIN_EMAIL=admin@example.com

# In-memory transport keeps handler tests from dialing a broker.
MESSENGER_EVENTS_DSN=in-memory://
