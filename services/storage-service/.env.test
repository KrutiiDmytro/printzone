# Test environment. Self-contained: local disk backend, no AWS, no broker.
APP_ENV=test
APP_DEBUG=0
APP_SECRET=test_secret

STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AWS_S3_BUCKET=
AWS_S3_VERSION=latest

# Dedicated passphrase-free keypair (config/jwt-test) mints service tokens in tests.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt-test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt-test/public.pem
JWT_PASSPHRASE=
