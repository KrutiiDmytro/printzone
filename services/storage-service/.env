# Storage Service — default (dev) environment. Override secrets in .env.local.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_storage_service_secret

# Object-storage backend. local → var/storage on disk; s3 → AWS S3 (set creds below).
STORAGE_TYPE=local

# AWS S3 credentials (used when STORAGE_TYPE=s3). Real values go in .env.local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AWS_S3_BUCKET=
AWS_S3_VERSION=latest

# Shared RS256 public key with the monolith → validates S2S tokens it signs.
# Storage only VERIFIES (never signs), so no passphrase needed. The monolith's
# config/jwt is mounted read-only at /jwt (see compose.yaml).
JWT_SECRET_KEY=/jwt/private.pem
JWT_PUBLIC_KEY=/jwt/public.pem
JWT_PASSPHRASE=
