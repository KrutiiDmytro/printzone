# Storage Service — default (dev) environment. Override secrets in .env.local.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_storage_service_secret

# Object-storage backend. local → var/storage on disk; s3 → AWS S3 (set creds below).
STORAGE_TYPE=local

# AWS S3 credentials (used when STORAGE_TYPE=s3). Real values go in .env.local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AWS_S3_BUCKET=
AWS_S3_VERSION=latest

# JWT public key for validating monolith-signed S2S tokens (wired in Step 2).
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
