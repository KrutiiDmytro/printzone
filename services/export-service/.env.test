# Test environment. Self-contained: in-memory SQLite + a dedicated passphrase-free
# JWT keypair (config/jwt-test) used to mint service tokens for the API tests.
APP_ENV=test
APP_DEBUG=0
APP_SECRET=test_secret

DATABASE_URL="sqlite:///:memory:"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt-test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt-test/public.pem
JWT_PASSPHRASE=

# In-memory transport keeps dispatch tests from touching the DB queue.
MESSENGER_TRANSPORT_DSN=in-memory://

CATALOG_SERVICE_URL=http://catalog-service
ORDER_SERVICE_URL=http://order-service
USER_SERVICE_URL=http://user-service
STORAGE_SERVICE_URL=http://storage-service

MAILER_DSN=null://null
ADMIN_EMAIL=admin@example.com
