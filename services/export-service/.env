# Export Service — default (dev) environment. Override secrets in .env.local.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_export_service_secret

# Own database (database-per-service).
DATABASE_URL="postgresql://app:changeme@db-export:5432/export_service?serverVersion=16&charset=utf8"

# Shared RS256 keypair with the monolith. Unlike verify-only services, the
# export-service SIGNS service tokens for its own outbound calls to
# catalog/order/user/storage — so it needs the private key + passphrase.
JWT_SECRET_KEY=/jwt/private.pem
JWT_PUBLIC_KEY=/jwt/public.pem
JWT_PASSPHRASE=

# Internal async job queue (Doctrine transport on the service's own DB). The
# export-worker consumes it; nothing crosses the network.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=true

# Upstream services the extractors read from (S2S HTTP) + storage for results.
CATALOG_SERVICE_URL=http://catalog-service
ORDER_SERVICE_URL=http://order-service
USER_SERVICE_URL=http://user-service
STORAGE_SERVICE_URL=http://storage-service

# Completion/failure emails are sent by the service itself.
MAILER_DSN=smtp://mailer:1025
ADMIN_EMAIL=admin@example.com
