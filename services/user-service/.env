# User Service — default (dev) environment. Override secrets in .env.local.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_user_service_secret

# Own database (database-per-service). Independent from the monolith DB.
DATABASE_URL="postgresql://app:changeme@db-user:5432/user_service?serverVersion=16&charset=utf8"

# Shared RS256 keypair with the monolith → tokens issued here are trusted there.
# The monolith's config/jwt is mounted read-only at /jwt (see compose.yaml).
JWT_SECRET_KEY=/jwt/private.pem
JWT_PUBLIC_KEY=/jwt/public.pem
JWT_PASSPHRASE=
