# Catalog Service — default (dev) environment. Override secrets in .env.local.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_catalog_service_secret

# Own database (database-per-service).
DATABASE_URL="postgresql://app:changeme@db-catalog:5432/catalog_service?serverVersion=16&charset=utf8"

# Shared RS256 public key with the monolith → validates service-to-service tokens
# the monolith signs. Catalog only VERIFIES (never signs), so no passphrase needed.
JWT_SECRET_KEY=/jwt/private.pem
JWT_PUBLIC_KEY=/jwt/public.pem
JWT_PASSPHRASE=
