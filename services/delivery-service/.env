# Delivery Service — default (dev) environment. Override secrets in .env.local.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_delivery_service_secret

# Own database (database-per-service).
DATABASE_URL="postgresql://app:changeme@db-delivery:5432/delivery_service?serverVersion=16&charset=utf8"

# Shared RS256 public key with the monolith → validates service-to-service tokens
# the monolith/order-service sign. Delivery only VERIFIES (never signs), so no
# passphrase needed.
JWT_SECRET_KEY=/jwt/private.pem
JWT_PUBLIC_KEY=/jwt/public.pem
JWT_PASSPHRASE=

# Outbound integration events (shipment.*) → the monolith's RabbitMQ topic exchange.
# Only the delivery-relay worker dials the broker; the HTTP service just writes
# outbox rows. The relay joins the monolith network and reaches it as `rabbitmq`.
MESSENGER_EVENTS_DSN=amqp://guest:guest@rabbitmq:5672/%2f/events

# Delivery provider: fake (deterministic, default) or nova_poshta (real API).
DELIVERY_PROVIDER=fake
NOVA_POSHTA_API_KEY=
