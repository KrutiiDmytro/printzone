# Order Service — default (dev) environment. Override secrets in .env.local.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_order_service_secret

# Own database (database-per-service).
DATABASE_URL="postgresql://app:changeme@db-order:5432/order_service?serverVersion=16&charset=utf8"

# Shared RS256 public key with the monolith → validates service-to-service tokens
# the monolith signs. Order only VERIFIES (never signs), so no passphrase needed.
JWT_SECRET_KEY=/jwt/private.pem
JWT_PUBLIC_KEY=/jwt/public.pem
JWT_PASSPHRASE=

# Outbound integration events (order.*) → the monolith's RabbitMQ topic exchange.
# Only the order-relay worker dials the broker; the HTTP service just writes
# outbox rows. The relay joins the monolith network and reaches it as `rabbitmq`.
MESSENGER_EVENTS_DSN=amqp://guest:guest@rabbitmq:5672/%2f/events

# Stripe (order-service owns checkout-session creation + webhook).
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
