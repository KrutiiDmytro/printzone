# Test environment. Self-contained: in-memory SQLite + a dedicated passphrase-free
# JWT keypair (config/jwt-test) used to mint service tokens for the API tests.
APP_ENV=test
APP_DEBUG=0
APP_SECRET=test_secret

DATABASE_URL="sqlite:///:memory:"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt-test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt-test/public.pem
JWT_PASSPHRASE=

# In-memory transport keeps checkout/payment-event tests from dialing a broker.
MESSENGER_EVENTS_DSN=in-memory://

# payment-service is stubbed in tests (PaymentClient), so this is never dialled.
PAYMENT_SERVICE_URL=http://payment-service.test
