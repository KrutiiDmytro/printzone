# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# OAuth (контролери читають $_ENV у конструкторі — потрібні для PHPUnit)
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback
GITHUB_CLIENT_ID=test-github-client-id
GITHUB_CLIENT_SECRET=test-github-client-secret
GITHUB_REDIRECT_URI=http://localhost/auth/github/callback

# Database for tests - використовую SQLite в пам'яті (найшвидше)
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

# Або якщо потрібна PostgreSQL тестова база:
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/app_test?serverVersion=16&charset=utf8"