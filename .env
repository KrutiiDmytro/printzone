###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=changeme_in_dotenv_local
DEFAULT_URI=http://e-commerce.it.com
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Пароль и полный URL БД — в .env.local (должен совпадать с POSTGRES_* для Docker)
DATABASE_URL="postgresql://app:changeme@database:5432/app?serverVersion=16&charset=utf8"
DATABASE_REPLICA_URL="postgresql://app:changeme@database-replica:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> printzone/catalog-service ###
# Catalog Service base URL (Phase 4). Export reads products from it over HTTP.
# Cross-compose dev: reach the service's published :8002 via the Docker host.
CATALOG_SERVICE_URL=http://host.docker.internal:8002
###< printzone/catalog-service ###

###> printzone/order-service ###
# Order Service base URL (Phase 3). Checkout delegates order creation + Stripe
# session here; Export reads orders from it over HTTP. Dev: published :8003.
ORDER_SERVICE_URL=http://host.docker.internal:8003
###< printzone/order-service ###

###> printzone/cart-service ###
# Cart Service base URL (step 4). Persistent cart of authenticated users.
# Cross-compose dev: reach the service's published :8004 via the Docker host.
CART_SERVICE_URL=http://host.docker.internal:8004
###< printzone/cart-service ###

###> printzone/storage-service ###
# Storage Service base URL (phase 7). Object backend (local/S3) + presigned URLs.
# Cross-compose dev: reach the service's published :8008 via the Docker host.
STORAGE_SERVICE_URL=http://host.docker.internal:8008
###< printzone/storage-service ###

###> printzone/export-service ###
# Export Service base URL (phase 7). Async CSV/JSON/XML report generation.
# Cross-compose dev: reach the service's published :8009 via the Docker host.
EXPORT_SERVICE_URL=http://host.docker.internal:8009
###< printzone/export-service ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# RabbitMQ transport for outbound domain (integration) events, published by the outbox relay.
MESSENGER_EVENTS_DSN=amqp://guest:guest@rabbitmq:5672/%2f/events
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
###< nelmio/cors-bundle ###

###> docker compose ###
POSTGRES_VERSION=16
POSTGRES_DB=app
POSTGRES_USER=app
###< docker compose ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
###< lexik/jwt-authentication-bundle ###

