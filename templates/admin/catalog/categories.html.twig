{% extends 'admin/base.html.twig' %}

{% block title %}Categories{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Categories</h1>
    <a href="{{ path('admin_catalog_category_new') }}" class="btn btn-primary">
        <i class="fa fa-plus"></i> Create category
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Type</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for c in categories %}
                    <tr>
                        <td>{{ c.name }}</td>
                        <td><code>{{ c.slug }}</code></td>
                        <td>{{ c.parentId ? 'Subcategory' : 'Root' }}</td>
                        <td class="text-end text-nowrap">
                            <a href="{{ path('admin_catalog_category_edit', {id: c.id}) }}" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form method="post" action="{{ path('admin_catalog_category_delete', {id: c.id}) }}" class="d-inline"
                                  onsubmit="return confirm('Delete this category?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('catalog_admin') }}">
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="text-center text-muted py-4">No categories.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
