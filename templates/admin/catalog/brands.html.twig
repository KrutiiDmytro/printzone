{% extends 'admin/base.html.twig' %}

{% block title %}Brands{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Brands</h1>
    <a href="{{ path('admin_catalog_brand_new') }}" class="btn btn-primary">
        <i class="fa fa-plus"></i> Create brand
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Color</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for b in brands %}
                    <tr>
                        <td>{{ b.name }}</td>
                        <td><code>{{ b.slug }}</code></td>
                        <td>
                            {% if b.color %}
                                <span class="d-inline-block rounded" style="width:16px;height:16px;background:{{ b.color }};vertical-align:middle"></span>
                                <code>{{ b.color }}</code>
                            {% else %}—{% endif %}
                        </td>
                        <td class="text-end text-nowrap">
                            <a href="{{ path('admin_catalog_brand_edit', {id: b.id}) }}" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form method="post" action="{{ path('admin_catalog_brand_delete', {id: b.id}) }}" class="d-inline"
                                  onsubmit="return confirm('Delete this brand?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('catalog_admin') }}">
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="text-center text-muted py-4">No brands.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
