{% extends 'admin/base.html.twig' %}

{% block title %}{{ brand ? 'Edit brand' : 'New brand' }}{% endblock %}

{% block content %}
<h1 class="mb-4">{{ brand ? 'Edit brand' : 'New brand' }}</h1>

<div class="card">
    <div class="card-body">
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('catalog_admin') }}">

            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Name</label>
                    <input type="text" name="name" class="form-control" required value="{{ brand.name ?? '' }}">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Slug</label>
                    <input type="text" name="slug" class="form-control" required value="{{ brand.slug ?? '' }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Color</label>
                    <input type="color" name="color" class="form-control form-control-color"
                           value="{{ brand.color ?? '#000000' }}" title="Brand color">
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Save</button>
                <a href="{{ path('admin_catalog_brands') }}" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
