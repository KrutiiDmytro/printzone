{% extends 'admin/base.html.twig' %}

{% block title %}{{ category ? 'Edit category' : 'New category' }}{% endblock %}

{% block content %}
<h1 class="mb-4">{{ category ? 'Edit category' : 'New category' }}</h1>

<div class="card">
    <div class="card-body">
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('catalog_admin') }}">

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Name</label>
                    <input type="text" name="name" class="form-control" required value="{{ category.name ?? '' }}">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Slug</label>
                    <input type="text" name="slug" class="form-control" required value="{{ category.slug ?? '' }}">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Parent</label>
                    <select name="parent" class="form-select">
                        <option value="">— none (root) —</option>
                        {% for c in categories %}
                            {% if c.id != (category.id ?? null) %}
                                <option value="{{ c.id }}" {{ (category.parentId ?? null) == c.id ? 'selected' : '' }}>{{ c.name }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Save</button>
                <a href="{{ path('admin_catalog_categories') }}" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
