{% extends 'admin/base.html.twig' %}

{% block title %}{{ product ? 'Edit product' : 'New product' }}{% endblock %}

{% block content %}
<h1 class="mb-4">{{ product ? 'Edit product' : 'New product' }}</h1>

<div class="card">
    <div class="card-body">
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('catalog_admin') }}">

            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Name</label>
                    <input type="text" name="name" class="form-control" required value="{{ product.name ?? '' }}">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Featured</label>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" name="isFeatured" value="1"
                               {{ product.isFeatured ?? false ? 'checked' : '' }}>
                        <label class="form-check-label">Show on home</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Category</label>
                    <select name="category" class="form-select" required>
                        <option value="">— select —</option>
                        {% for c in categories %}
                            <option value="{{ c.id }}" {{ (product.category.id ?? null) == c.id ? 'selected' : '' }}>{{ c.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Brand</label>
                    <select name="brand" class="form-select">
                        <option value="">— none —</option>
                        {% for b in brands %}
                            <option value="{{ b.id }}" {{ (product.brand.id ?? null) == b.id ? 'selected' : '' }}>{{ b.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Price (€)</label>
                    <input type="number" step="0.01" min="0" name="price" class="form-control" required
                           value="{{ product ? (product.price / 100)|number_format(2, '.', '') : '' }}">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Stock</label>
                    <input type="number" min="0" name="stock" class="form-control" required value="{{ product.stock ?? 0 }}">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Image key</label>
                    <input type="text" name="image" class="form-control" value="{{ product.image ?? '' }}"
                           placeholder="e.g. product-1.png">
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Description</label>
                    <textarea name="description" class="form-control" rows="4">{{ product.description ?? '' }}</textarea>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Save</button>
                <a href="{{ path('admin_catalog_products') }}" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
