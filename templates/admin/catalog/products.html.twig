{% extends 'admin/base.html.twig' %}

{% block title %}Products{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Products</h1>
    <a href="{{ path('admin_catalog_product_new') }}" class="btn btn-primary">
        <i class="fa fa-plus"></i> Create product
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Stock</th>
                    <th>Featured</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for p in products %}
                    <tr>
                        <td>{{ p.name }}</td>
                        <td>{{ p.category.name ?? '—' }}</td>
                        <td>{{ p.brand.name ?? '—' }}</td>
                        <td class="text-end">€{{ (p.price / 100)|number_format(2) }}</td>
                        <td class="text-end">{{ p.stock }}</td>
                        <td>{{ p.isFeatured ? '★' : '' }}</td>
                        <td class="text-end text-nowrap">
                            <a href="{{ path('admin_catalog_product_edit', {id: p.id}) }}" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form method="post" action="{{ path('admin_catalog_product_delete', {id: p.id}) }}" class="d-inline"
                                  onsubmit="return confirm('Delete this product?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('catalog_admin') }}">
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-center text-muted py-4">No products.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
