{% extends 'admin/base.html.twig' %}

{% block title %}Експорт даних{% endblock %}

{% block content %}
<h1 class="mb-4">Експорт даних</h1>
<div class="row">
    <div class="col-md-5">
        <div class="card mb-4">
            <div class="card-header fw-semibold">Новий експорт</div>
            <div class="card-body">
                <form method="post" action="{{ path('admin_export_submit') }}" id="export-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('export') }}">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Тип даних</label>
                        <div class="d-flex gap-2">
                            {% for type in export_types %}
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="type"
                                           id="type_{{ type.value }}" value="{{ type.value }}"
                                           {{ loop.first ? 'checked' : '' }}
                                           onchange="showFilters(this.value)">
                                    <label class="form-check-label" for="type_{{ type.value }}">
                                        {{ type.value|capitalize }}
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Формат</label>
                        <div class="d-flex gap-2">
                            {% for format in export_formats %}
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="format"
                                           id="format_{{ format.value }}" value="{{ format.value }}"
                                           {{ loop.first ? 'checked' : '' }}>
                                    <label class="form-check-label text-uppercase" for="format_{{ format.value }}">
                                        {{ format.value }}
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    {# Product filters #}
                    <div id="filters-products" class="filters-block">
                        <hr><p class="text-muted small mb-2">Фільтри товарів (необов'язково)</p>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" name="filters[priceMin]" class="form-control form-control-sm"
                                       placeholder="Ціна від (центи)">
                            </div>
                            <div class="col-6">
                                <input type="number" name="filters[priceMax]" class="form-control form-control-sm"
                                       placeholder="Ціна до (центи)">
                            </div>
                            <div class="col-6">
                                <input type="number" name="filters[stockMin]" class="form-control form-control-sm"
                                       placeholder="Залишок від">
                            </div>
                            <div class="col-6">
                                <input type="number" name="filters[stockMax]" class="form-control form-control-sm"
                                       placeholder="Залишок до">
                            </div>
                            <div class="col-6">
                                <input type="number" name="filters[category]" class="form-control form-control-sm"
                                       placeholder="ID категорії">
                            </div>
                            <div class="col-6">
                                <select name="filters[isFeatured]" class="form-select form-select-sm">
                                    <option value="">Всі товари</option>
                                    <option value="1">Тільки рекомендовані</option>
                                    <option value="0">Не рекомендовані</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    {# Order filters #}
                    <div id="filters-orders" class="filters-block d-none">
                        <hr><p class="text-muted small mb-2">Фільтри замовлень (необов'язково)</p>
                        <div class="row g-2">
                            <div class="col-12">
                                <select name="filters[status]" class="form-select form-select-sm">
                                    <option value="">Всі статуси</option>
                                    {% for status in order_statuses %}
                                        <option value="{{ status }}">{{ status }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-6">
                                <input type="date" name="filters[dateFrom]" class="form-control form-control-sm"
                                       placeholder="Дата від">
                            </div>
                            <div class="col-6">
                                <input type="date" name="filters[dateTo]" class="form-control form-control-sm"
                                       placeholder="Дата до">
                            </div>
                        </div>
                    </div>

                    {# User filters #}
                    <div id="filters-users" class="filters-block d-none">
                        <hr><p class="text-muted small mb-2">Фільтри користувачів (необов'язково)</p>
                        <div class="row g-2">
                            <div class="col-12">
                                <input type="text" name="filters[email]" class="form-control form-control-sm"
                                       placeholder="Email (частковий збіг)">
                            </div>
                            <div class="col-12">
                                <select name="filters[role]" class="form-select form-select-sm">
                                    <option value="">Всі ролі</option>
                                    <option value="ROLE_ADMIN">Адміністратори</option>
                                    <option value="ROLE_USER">Користувачі</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-download me-1"></i> Експортувати
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card">
            <div class="card-header fw-semibold">Останні завдання</div>
            <div class="card-body p-0">
                {% if jobs is empty %}
                    <p class="text-muted p-3 mb-0">Завдань ще немає.</p>
                {% else %}
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Тип</th>
                                <th>Формат</th>
                                <th>Статус</th>
                                <th>Створено</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for job in jobs %}
                                <tr>
                                    <td>{{ job.id }}</td>
                                    <td>{{ job.type.value }}</td>
                                    <td class="text-uppercase">{{ job.format.value }}</td>
                                    <td>
                                        {% set badge = {
                                            'pending': 'secondary',
                                            'processing': 'primary',
                                            'completed': 'success',
                                            'failed': 'danger'
                                        } %}
                                        <span class="badge bg-{{ badge[job.status.value] ?? 'secondary' }}">
                                            {{ job.status.value }}
                                        </span>
                                    </td>
                                    <td>{{ job.createdAt|date('d.m.Y H:i') }}</td>
                                    <td>
                                        {% if job.status.value == 'completed' %}
                                            <a href="{{ path('admin_export_download', {id: job.id}) }}"
                                               class="btn btn-xs btn-outline-success">
                                                <i class="fa fa-download"></i>
                                            </a>
                                        {% elseif job.status.value == 'failed' %}
                                            <span class="text-danger small" title="{{ job.errorMessage }}">
                                                <i class="fa fa-exclamation-circle"></i>
                                            </span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script>
function showFilters(type) {
    document.querySelectorAll('.filters-block').forEach(el => el.classList.add('d-none'));
    const block = document.getElementById('filters-' + type);
    if (block) block.classList.remove('d-none');
}
document.addEventListener('DOMContentLoaded', function () {
    const checked = document.querySelector('input[name="type"]:checked');
    if (checked) showFilters(checked.value);
});
</script>
{% endblock %}
