<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Admin{% endblock %} — Панель управління</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" rel="stylesheet">
</head>
<body class="bg-light">

<nav class="navbar navbar-expand navbar-dark bg-dark px-3 mb-4">
    <a class="navbar-brand fw-bold" href="{{ path('admin_dashboard') }}">
        <i class="fa fa-cog me-1"></i> Admin
    </a>
    <div class="navbar-nav ms-auto">
        <a class="nav-link" href="{{ path('admin_dashboard') }}">
            <i class="fa fa-home me-1"></i> Dashboard
        </a>
        <a class="nav-link" href="{{ path('admin_export') }}">
            <i class="fa fa-download me-1"></i> Export
        </a>
    </div>
</nav>

<div class="container-fluid px-4">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block content %}{% endblock %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
