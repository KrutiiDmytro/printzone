<div class="order-items">
    <h4>Товары в заказе</h4>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Фото</th>
                <th>Товар</th>
                <th>Количество</th>
                <th>Цена за единицу</th>
                <th>Итого</th>
            </tr>
        </thead>
        <tbody>
            {% for item in field.value %}
                <tr>
                    <td style="width: 80px;">
                        <div style="width: 50px; height: 50px; background: #eee; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: #999;">
                            <i class="fa fa-image"></i>
                        </div>
                    </td>
                    <td>{{ item.productName }}</td>
                    <td>{{ item.quantity }}</td>
                    <td>${{ (item.price / 100)|number_format(2) }}</td>
                    <td>${{ ((item.price * item.quantity) / 100)|number_format(2) }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-muted">Нет товаров в заказе</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>