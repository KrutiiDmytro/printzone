{% extends 'admin/base.html.twig' %}

{% block title %}Order {{ order.id }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Order detail</h1>
    <a href="{{ path('admin_orders') }}" class="btn btn-outline-secondary">← Back to orders</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Order ID</dt><dd class="col-sm-8">{{ order.id }}</dd>
                    <dt class="col-sm-4">Customer</dt><dd class="col-sm-8">{{ order.userEmail }}</dd>
                    <dt class="col-sm-4">Created</dt><dd class="col-sm-8">{{ order.createdAt is empty ? '—' : order.createdAt|date('d.m.Y H:i') }}</dd>
                    <dt class="col-sm-4">Total</dt><dd class="col-sm-8">€{{ (order.totalAmount / 100)|number_format(2) }}</dd>
                    <dt class="col-sm-4">Status</dt><dd class="col-sm-8"><span class="badge bg-secondary">{{ order.status }}</span></dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <form method="post" action="{{ path('admin_order_status', {id: order.id}) }}" class="row g-2 align-items-end">
                    <input type="hidden" name="_token" value="{{ csrf_token('order_admin') }}">
                    <div class="col-auto">
                        <label class="form-label">Update status</label>
                        <select name="status" class="form-select">
                            {% for s in statuses %}
                                <option value="{{ s }}" {{ order.status == s ? 'selected' : '' }}>{{ s }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">Items</div>
    <div class="table-responsive">
        <table class="table table-striped mb-0 align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Unit price</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                {% for item in order.items %}
                    <tr>
                        <td>{{ item.productName }}</td>
                        <td class="text-end">{{ item.quantity }}</td>
                        <td class="text-end">€{{ (item.price / 100)|number_format(2) }}</td>
                        <td class="text-end">€{{ ((item.price * item.quantity) / 100)|number_format(2) }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="text-center text-muted py-4">No items.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
