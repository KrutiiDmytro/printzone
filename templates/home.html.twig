    {# ===== PRINTER FINDER DATA + LOGIC ===== #}
    <script>
    (function () {
        const BASE = '{{ path('app_shop') | slice(0, -4) }}'; // strip "shop" → base url

        /* Build models map from DB via Twig */
        const MODELS = {
            {% for brand in brands %}
            {{ brand.slug | json_encode | raw }}: [
                {% for m in brand_models(brand.slug) %}
                { name: {{ m.name | json_encode | raw }}, slug: {{ m.slug | json_encode | raw }} }{% if not loop.last %},{% endif %}
                {% endfor %}
            ]{% if not loop.last %},{% endif %}
            {% endfor %}
        };

        const brandSelect = document.getElementById('pf-brand');
        const modelSelect = document.getElementById('pf-model');
        const textInput   = document.getElementById('pf-text');
        const acList      = document.getElementById('pf-autocomplete');
        const ddBtn       = document.getElementById('pf-dd-btn');

        /* ── Autocomplete ── */
        let _acTimer = null;

        textInput.addEventListener('input', function () {
            const q = this.value.trim();
            acList.innerHTML = '';
            acList.classList.remove('open');
            clearTimeout(_acTimer);
            if (q.length < 2) return;

            _acTimer = setTimeout(() => {
                fetch('/search/autocomplete?q=' + encodeURIComponent(q))
                    .then(r => r.json())
                    .then(hits => {
                        acList.innerHTML = '';
                        if (!hits.length) { acList.classList.remove('open'); return; }
                        hits.forEach(hit => {
                            const div = document.createElement('div');
                            div.className = 'pf-ac-item';
                            div.innerHTML = `${hit.name}<span class="pf-ac-brand">${hit.brandName}</span>`;
                            div.addEventListener('mousedown', () => selectAcItem(hit));
                            acList.appendChild(div);
                        });
                        acList.classList.add('open');
                    });
            }, 200);
        });

        textInput.addEventListener('blur', () => setTimeout(() => acList.classList.remove('open'), 150));
        textInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') { pfTextSearch(); acList.classList.remove('open'); }
        });

        function selectAcItem(hit) {
            acList.classList.remove('open');
            window.location.href = '/brand/' + hit.brandSlug;
        }

        /* ── Dropdown logic ── */
        window.pfBrandChange = function (preselectModelSlug = null) {
            const slug = brandSelect.value;
            modelSelect.innerHTML = '<option value="">Select model</option>';
            if (!slug) {
                modelSelect.disabled = true;
                pfUpdateBtn();
                return;
            }
            const models = MODELS[slug] ?? [];
            models.forEach(m => {
                const opt = document.createElement('option');
                opt.value = m.slug;
                opt.textContent = m.name;
                if (m.slug === preselectModelSlug) opt.selected = true;
                modelSelect.appendChild(opt);
            });
            modelSelect.disabled = false;

            /* sync text input when brand chosen via dropdown */
            const brandName = brandSelect.options[brandSelect.selectedIndex]?.dataset.name ?? '';
            if (textInput.value === '' || !textInput.value.toLowerCase().startsWith(brandName.toLowerCase())) {
                textInput.value = brandName + ' ';
            }
            pfUpdateBtn();
        };

        window.pfUpdateBtn = function () {
            if (!brandSelect.value) {
                ddBtn.textContent = 'Select manufacturer';
                ddBtn.className = 'pf-dd-btn state-empty';
            } else {
                ddBtn.textContent = 'Find cartridges';
                ddBtn.className = 'pf-dd-btn state-ready';
            }
        };

        /* ── Search actions ── */
        window.pfTextSearch = function () {
            const slug = brandSelect.value;
            if (slug) { window.location.href = '/brand/' + slug; return; }
            const q = textInput.value.trim();
            if (q) { window.location.href = '{{ path('app_shop') }}?q=' + encodeURIComponent(q); }
        };

        window.pfDropdownSearch = function () {
            const slug = brandSelect.value;
            if (!slug) return;
            window.location.href = '/brand/' + slug;
        };
    })();
    </script>

