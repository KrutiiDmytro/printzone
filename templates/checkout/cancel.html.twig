{% extends 'base.html.twig' %}

{% block title %}Payment Cancelled - PrintZone{% endblock %}

{% block body %}
    <div class="container-fluid page-header py-5">
        <h1 class="text-center text-white display-6 wow fadeInUp" data-wow-delay="0.1s">Payment Cancelled</h1>
        <ol class="breadcrumb justify-content-center mb-0 wow fadeInUp" data-wow-delay="0.3s">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Home</a></li>
            <li class="breadcrumb-item active text-white">Cancelled</li>
        </ol>
    </div>

    <div class="container-fluid bg-light overflow-hidden py-5">
        <div class="container py-5 text-center">
            <div class="wow fadeInUp" data-wow-delay="0.1s">
                <i class="fas fa-times-circle text-danger" style="font-size: 5rem;"></i>
                <h2 class="mt-4 mb-3">Payment was not completed</h2>
                <p class="text-muted mb-4">
                    Your order has not been charged. You can try again or go back to the shop.
                </p>
                <a href="{{ path('app_checkout') }}" class="btn btn-primary py-3 px-4 me-3">
                    Try Again
                </a>
                <a href="{{ path('app_home') }}" class="btn btn-outline-secondary py-3 px-4">
                    Continue Shopping
                </a>
            </div>
        </div>
    </div>
{% endblock %}
